{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/modules/mandi/**/*",
    "src/modules/marketplace/**/*",
    "src/modules/superadmin/**/*",
    "src/modules/farmer/**/*",
    "src/modules/export/**/*",
    "src/modules/ai/**/*",
    "src/modules/batch/**/*",
    "src/modules/crop/**/*",
    "src/modules/farm/**/*",
    "src/modules/fpo/**/*",
    "src/database/test-*.ts"
  ]
}
